<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- OAuth deep link: Google/Apple sign-in runs in the system browser
                 (Chrome Custom Tab) to dodge the disallowed_useragent webview block,
                 then returns via madgigz://auth-callback. singleTask + this filter
                 routes it back into MainActivity, where the App plugin fires
                 appUrlOpen and NativeBridge does the PKCE code exchange. Mirrors the
                 CFBundleURLSchemes "madgigz" entry in ios/App/App/Info.plist. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="madgigz" android:host="auth-callback" />
            </intent-filter>

            <!-- App Links (#134): verified https links to our own domain open the
                 app instead of the browser. autoVerify makes Android fetch
                 /.well-known/assetlinks.json at install and, once the domain is
                 verified, these links open straight here with no chooser. Scoped
                 by pathPrefix to the SAME paths the iOS AASA claims (shared
                 events, profiles, and the auth return) so unrelated links on the
                 domain still open normally. singleTask routes it into the running
                 MainActivity, where the App plugin fires appUrlOpen and
                 NativeBridge navigates the webview to the path. assetlinks is
                 already served (both signing fingerprints) — this is the on-device
                 half that needs the native rebuild. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="madgigz.aurasonic.es" />
                <data android:pathPrefix="/e/" />
                <data android:pathPrefix="/profile/" />
                <data android:pathPrefix="/auth/" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- QR ticket scanning at the door (profile/scan) uses the WebView camera via
         getUserMedia. Mirrors NSCameraUsageDescription in the iOS Info.plist. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
</manifest>
