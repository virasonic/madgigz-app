{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "madgigz-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "madgigz-staging-db",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "set -a; . ./.env.staging; set +a; npm run dev -- -p 3001"
      ],
      "port": 3001
    }
  ]
}
